/target

# Firmware build intermediates (firmware.bin is kept: the emulator loads it)
/firmware/*.o
/firmware/*.elf

# Rust firmware build output (the .bin files are kept: the emulator loads them)
/firmware/hello-rs/target
/firmware/float-rs/target
/firmware/gyro-rs/target

# Drone crates build output
/drone/*/target

# Drone simulation: the default run output (the cases in drone/sim/runs are kept)
/drone/sim/run.csv
/drone/sim/quad.csv
